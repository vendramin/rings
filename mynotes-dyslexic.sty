% ============================================================
% mynotes-dyslexic.sty
%
% Dyslexia-friendly drop-in replacement for mynotes.sty.
%
% Usage: in notes.tex, change
%     \usepackage{mynotes}
% to
%     \usepackage{mynotes-dyslexic}
% and compile with XELATEX (not pdflatex) -- this package needs
% fontspec to load the OpenDyslexic font, and fontspec requires
% xelatex or lualatex:
%
%     xelatex notes.tex
%
% Everything else -- theorem environments, tcolorbox boxes,
% macros (\Irr, \Ann, \Q, \Z, ...), section numbering, index,
% bibliography -- is untouched, so every existing chapter file
% (introduction.tex, 01.tex, ..., solutions.tex) compiles as-is.
%
% What changed vs. mynotes.sty, and why (British Dyslexia
% Association / Dyslexia Style Guide recommendations):
%   1. Body font  -> OpenDyslexic (weighted bottoms, distinct
%                    letter shapes, no italic body text).
%   2. Line spacing -> ~1.25x, extra paragraph spacing, so lines
%                    and paragraphs don't run together.
%   3. Justification -> ragged-right instead of fully justified,
%                    so word spacing stays even (no "rivers").
%   4. Page colour -> soft cream instead of pure white, which
%                    reduces glare/visual stress for many readers.
%   5. Headings   -> subsubsection italics removed (italics are
%                    hard to decode for dyslexic readers); bold
%                    used instead, colour kept.
%   6. Margins    -> slightly wider, which shortens line length.
% Math typesetting itself is left on the normal LaTeX math fonts;
% only body text uses OpenDyslexic.
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mynotes-dyslexic}[2026/08/31 v1.0 Dyslexia-friendly personal lecture notes style]

% ------------------------------------------------------------
% Packages (same as mynotes.sty)
% ------------------------------------------------------------
\RequirePackage[foot]{amsaddr}
\RequirePackage{hyperref}
\RequirePackage{listings}
\RequirePackage{tikz-cd}
\usetikzlibrary{arrows,positioning,shapes}
\RequirePackage{datetime}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{stmaryrd}
\RequirePackage{mdframed}
\RequirePackage{textcomp}
\RequirePackage{colortbl}
\RequirePackage[most]{tcolorbox}
\RequirePackage[margin=1.25in,footskip=.25in]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage[english.nosectiondot]{babel}

% ------------------------------------------------------------
% 1. Dyslexia-friendly font
%
%    DEFAULT (used below): Computer Modern Sans, selected the classic
%    LaTeX way via \familydefault. This needs NO font installation,
%    NO extra package, and NO engine change -- \sfdefault is a core
%    LaTeX kernel macro, defined for every installation there has
%    ever been, and this mechanism (NFSS, not fontspec) does not go
%    through your OS's font database at all, so it cannot fail the
%    way a fontspec-based "named system font" lookup can. Compile
%    this file with plain pdflatex, exactly like notes.tex.
%
%    A sans-serif, non-decorative, evenly spaced typeface is the
%    actual evidence-backed recommendation (British Dyslexia
%    Association style guide); a dedicated "dyslexia font" like
%    OpenDyslexic is an optional extra on top of that, not a
%    requirement -- see the OPT-IN block further down if you want
%    it and are willing to (a) install the font and (b) switch to
%    xelatex.
% ------------------------------------------------------------
\renewcommand{\familydefault}{\sfdefault}

