% column vector
\newcount\colveccount
\newcommand*\colvec[1]{
\global\colveccount#1
\begin{pmatrix}
        \colvecnext
        }
        \def\colvecnext#1{
        #1
        \global\advance\colveccount-1
        \ifnum\colveccount>0
        \\
        \expandafter\colvecnext
        \else
\end{pmatrix}
\fi
}

% ------------------------------------------------------------
% Theorem-like environments
% amsthm's default "plain" style sets the theorem BODY in italics
% (only the head, e.g. "Theorem 1.2.", is meant to stand out) --
% that means every theorem/lemma/proposition/corollary statement
% would be in italics, which is exactly the style dyslexic readers
% struggle with most. This custom style keeps the bold head but
% sets the body in upright text instead.
% ------------------------------------------------------------
\newtheoremstyle{dyslexicplain}%
  {}{}%                    space above/below
  {\normalfont}%           body font (upright, not italic)
  {}%                      indent
  {\bfseries}{}%           head font, head punctuation
  { }%                     space after head
  {}                       % head spec (default)
\theoremstyle{dyslexicplain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{xca}[theorem]{Exercise}
\newtheorem{bxca}[theorem]{Bonus exercise}
\newtheorem{remark}[theorem]{Remark}
\newtheorem{que}[theorem]{Question}
\newtheorem{conj}[theorem]{Conjecture}
\newtheorem{open}[theorem]{Open problem}
\newtheorem{convention}[theorem]{Convention}

\theoremstyle{remark}
\newtheorem*{claim}{Claim}

\newenvironment{sol}[1]
{\renewcommand{\qedsymbol}{}\begin{proof}[\ref{#1}]}
  {\end{proof}}

\newenvironment{problem}
{\begin{tcolorbox}[boxrule=0pt,frame hidden,colback=blue!5!white,
  left=.3em, right=.3em, top=-.2em, bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  before upper={\parindent4mm\noindent},
colframe=blue!55!white]\begin{open}}{\end{open}\end{tcolorbox}}

\newenvironment{question}
{\begin{tcolorbox}[boxrule=0pt,frame hidden,colback=blue!5!white,
  left=.3em, right=.3em, top=-.2em, bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  before upper={\parindent4mm\noindent},
colframe=blue!55!white]\begin{que}}{\end{que}\end{tcolorbox}}

\newenvironment{conjecture}
{\begin{tcolorbox}[boxrule=0pt,frame hidden,colback=blue!5!white,
  left=.3em, right=.3em, top=-.2em, bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  before upper={\parindent4mm\noindent},
colframe=blue!55!white]\begin{conj}}{\end{conj}\end{tcolorbox}}

% Mandatory exercises: green background
\newenvironment{exercise}
{\begin{tcolorbox}[boxrule=0pt,frame hidden,colback=green!5!white,
  left=.3em, right=.3em, top=-.2em, bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  before upper={\parindent4mm\noindent},
colframe=green!55!black]\begin{xca}}{\end{xca}\end{tcolorbox}}

% Optional (bonus) exercises: yellow background
\newenvironment{bonus}
{\begin{tcolorbox}[boxrule=0pt,frame hidden,colback=yellow!15!white,
  left=.3em, right=.3em, top=-.2em, bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  before upper={\parindent4mm\noindent},
colframe=yellow!45!black]\begin{bxca}}{\end{bxca}\end{tcolorbox}}

\numberwithin{figure}{section}
\numberwithin{equation}{section}

% ------------------------------------------------------------
% Section / subsection / subsubsection titles
% (subsubsection: italics removed, bold used instead -- italic
% text is one of the harder styles for dyslexic readers to
% decode)
% ------------------------------------------------------------
\makeatletter
\renewcommand\section{\@startsection{section}{1}%
  \z@{.7\linespacing\@plus\linespacing}{.5\linespacing}%
  {\color{green!30!black}\normalfont\bfseries\centering}}
\renewcommand\subsection{\@startsection{subsection}{2}%
  \normalparindent{.5\linespacing\@plus.7\linespacing}{-.5em}%
  {\color{-red!55!green!50}\normalfont\bfseries}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}%
  \normalparindent\z@{-.5em}%
  {\color{green!50!blue}\normalfont\bfseries}}
\makeatother

% ------------------------------------------------------------
% Page style: running header/footer
% ------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[R]{\thepage}
\fancyhead[L]{\course}
\setlength{\headheight}{14pt}

