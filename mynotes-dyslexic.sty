% ------------------------------------------------------------
% 2. Line and paragraph spacing
% ------------------------------------------------------------
\RequirePackage{setspace}
\setstretch{1.25}
\setlength{\parskip}{0.6\baselineskip}

% ------------------------------------------------------------
% 3. Ragged-right instead of fully justified text
%    Comment this out if you prefer the original justified look.
% ------------------------------------------------------------
\RequirePackage{ragged2e}
\AtBeginDocument{\RaggedRight}

% ------------------------------------------------------------
% 4. Soft cream page background (reduces glare for many readers)
%    Comment out the \pagecolor line to go back to plain white
%    (e.g. if you plan to print on coloured paper already).
% ------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{creampage}{RGB}{253,246,227}
\pagecolor{creampage}

% ------------------------------------------------------------
% Hyperref setup
% ------------------------------------------------------------
\hypersetup{
  final,
  colorlinks,
  linkcolor=-red!55!green!50,
  citecolor=blue!50!red,
  urlcolor=green!30!black
}

\swapnumbers

\overfullrule=1mm

% ------------------------------------------------------------
% \course: name of the course, shown in the running header and
% (typically) used for \title{\course}. Give it a default so
% the package is self-contained; override in the main file with
% \renewcommand{\course}{...} before \begin{document}.
% ------------------------------------------------------------
\providecommand{\course}{}

% ------------------------------------------------------------
% Emphasis (kept: bold + colour, never italic)
% ------------------------------------------------------------
\renewcommand\emph[1]{\textcolor{blue!50!red}{\bfseries #1}}

% ------------------------------------------------------------
% Section numbering
% ------------------------------------------------------------
\renewcommand\thesection{\arabic{section}}
\renewcommand\thesubsection{\arabic{section}.\arabic{subsection}}

% ------------------------------------------------------------
% Table of contents "part" separators
% ------------------------------------------------------------
\newcommand{\TOCpart}[1]{\addtocontents{toc}%
{\bigskip\textcolor{green!40!blue}{\textbf{#1.}}}}

% ------------------------------------------------------------
% Pink box for optional comments
% ------------------------------------------------------------
\newtcolorbox{eqbox}[1][]
{
boxrule=0pt,frame hidden,colback=red!5!white,
  left=.3em, right=.3em, top=.3em, bottom=.3em,
  beforeafter skip balanced=.4\baselineskip plus 2pt,
  before upper={\parindent4mm},
colframe=blue!55!white
}
\newenvironment{optional}[1][]{
\begin{eqbox}
}{
\end{eqbox}
}

% ------------------------------------------------------------
% Code listings
%
% NOTE: the "listings" package has no built-in "Magma" language,
% so "language = Magma" alone makes every compile emit "Package
% Listings Error: language magma undefined." Under a plain
% pdflatex/xelatex run this only prints a warning-like error and
% still produces a PDF, so it's easy not to notice -- but tools
% that check the compiler's exit code (like latexmk, hence this
% Makefile) treat it as a real failure and stop. The minimal
% \lstdefinelanguage below just teaches listings enough of Magma's
% syntax (keywords, // comments, "..." strings) to stop the error;
% swap in a fuller definition later if you want richer highlighting.
% ------------------------------------------------------------
\lstdefinelanguage{Magma}{
    morekeywords={function,end,for,while,if,then,else,elif,return,%
                  local,true,false,print,forward,procedure,case,%
                  when,repeat,until,break,continue},
    sensitive=true,
    morecomment=[l]{//},
    morecomment=[s]{/*}{*/},
    morestring=[b]"
}
\lstset{
    language = Magma,
    basicstyle=\ttfamily\small,
    commentstyle=\small,
    backgroundcolor = \color{gray!20!white},
    showstringspaces = false,
    columns=fixed,
}

% ------------------------------------------------------------
% Section name used by amsproc's running head (e.g. "Lecture")
% ------------------------------------------------------------
\renewcommand\sectionname{\S}

% enumerate labels: 1), 2), 3), ...
\renewcommand{\labelenumi}{\textbf{\arabic{enumi})}}

\makeindex

